# ============================================================
# TiendaTech Microservices - Variables de Entorno
# Copiar este archivo como .env y completar los valores reales
# ============================================================

# Auth Service
AUTH_JWT_SECRET=changeitchangeitchangeitchangeitchangeitchangeitchangeit1234
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password
AUTH_POSTGRES_DB=authdb
AUTH_DATABASE_URL=jdbc:postgresql://auth-db:5432/authdb

# Resource Service
RESOURCE_POSTGRES_USER=resource_user
RESOURCE_POSTGRES_PASSWORD=resource_password
RESOURCE_POSTGRES_DB=resourcedb
RESOURCE_DATABASE_URL=jdbc:postgresql://resource-db:5432/resourcedb
NOTIFICATION_SERVICE_URL=http://notification-service:8003

# Notification Service
NOTIF_POSTGRES_USER=notif_user
NOTIF_POSTGRES_PASSWORD=notif_password
NOTIF_POSTGRES_DB=notificationdb
NOTIF_DATABASE_URL=jdbc:postgresql://notification-db:5432/notificationdb

# SMTP (usar valores reales en .env, nunca en el repositorio)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@tiendatech.com
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@tiendatech.com
