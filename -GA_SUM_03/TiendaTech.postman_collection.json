{
  "info": {
    "name": "TiendaTech Microservices - Flujos End-to-End",
    "description": "Colección con los 3 flujos obligatorios de prueba para la Entrega 2 del PFC.\n\nVariables requeridas:\n- gateway_url: http://localhost:8080\n- auth_host: http://localhost:8001\n- resource_host: http://localhost:8002\n- notification_host: http://localhost:8003\n- jwt_token: (se llena automáticamente en Flujo 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080" },
    { "key": "auth_host", "value": "http://localhost:8001" },
    { "key": "resource_host", "value": "http://localhost:8002" },
    { "key": "notification_host", "value": "http://localhost:8003" },
    { "key": "jwt_token", "value": "" },
    { "key": "product_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Flujo 1 - Registro y Login JWT",
      "description": "POST /register → POST /login → verificar JWT retornado",
      "item": [
        {
          "name": "1.1 Registrar Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - Usuario creado', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respuesta tiene username', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.username).to.eql('testuser');",
                  "});",
                  "pm.test('Tiene timestamp', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{auth_host}}/register", "host": ["{{auth_host}}"], "path": ["register"] }
          }
        },
        {
          "name": "1.2 Login - Obtener JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Login exitoso', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta tiene token JWT', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('jwt_token', json.data.token);",
                  "});",
                  "pm.test('Token tiene expiresIn', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.expiresIn).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"P@ssw0rd\"\n}"
            },
            "url": { "raw": "{{auth_host}}/login", "host": ["{{auth_host}}"], "path": ["login"] }
          }
        },
        {
          "name": "1.3 Validar Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Token válido', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('valid = true en respuesta', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.valid).to.be.true;",
                  "});",
                  "pm.test('Tiene username en data', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.username).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{auth_host}}/validate", "host": ["{{auth_host}}"], "path": ["validate"] }
          }
        }
      ]
    },
    {
      "name": "Flujo 2 - CRUD Productos con JWT",
      "description": "GET sin token (→401) → GET con token (→200) → POST → PUT → DELETE",
      "item": [
        {
          "name": "2.1 GET Productos SIN token (→ 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 - Sin token rechazado', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Mensaje de error presente', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{resource_host}}/", "host": ["{{resource_host}}"], "path": [""] }
          }
        },
        {
          "name": "2.2 GET Productos CON token (→ 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Con token aceptado', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Data es array', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{resource_host}}/", "host": ["{{resource_host}}"], "path": [""] }
          }
        },
        {
          "name": "2.3 POST Crear Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - Producto creado', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Producto tiene ID', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.be.above(0);",
                  "    pm.collectionVariables.set('product_id', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"description\": \"Laptop para desarrolladores\",\n  \"price\": 1500.00,\n  \"stock\": 10,\n  \"category\": \"Electronica\"\n}"
            },
            "url": { "raw": "{{resource_host}}/create", "host": ["{{resource_host}}"], "path": ["create"] }
          }
        },
        {
          "name": "2.4 PUT Actualizar Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Producto actualizado', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nombre actualizado correctamente', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.name).to.eql('Laptop Pro v2');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro v2\",\n  \"description\": \"Hardware actualizado\",\n  \"price\": 1600.00,\n  \"stock\": 5,\n  \"category\": \"Electronica\"\n}"
            },
            "url": { "raw": "{{resource_host}}/{{product_id}}", "host": ["{{resource_host}}"], "path": ["{{product_id}}"] }
          }
        },
        {
          "name": "2.5 DELETE Eliminar Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Producto eliminado', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Mensaje de eliminación', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include('eliminado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{resource_host}}/{{product_id}}", "host": ["{{resource_host}}"], "path": ["{{product_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Flujo 3 - Crear Recurso y Verificar Notificación",
      "description": "Crear producto → verificar que notification-service lo registró",
      "item": [
        {
          "name": "3.1 Crear Producto (dispara notificación)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - Producto creado', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Guardar ID del producto', function() {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('product_id', json.data.id);",
                  "    console.log('Producto creado con ID:', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado Mecánico\",\n  \"description\": \"Teclado para programadores\",\n  \"price\": 120.00,\n  \"stock\": 25,\n  \"category\": \"Periféricos\"\n}"
            },
            "url": { "raw": "{{resource_host}}/create", "host": ["{{resource_host}}"], "path": ["create"] }
          }
        },
        {
          "name": "3.2 Verificar Notificación en Notification Service",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Historial obtenido', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Historial tiene al menos una notificación', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "});",
                  "pm.test('Última notificación es PRODUCT_CREATED', function() {",
                  "    var json = pm.response.json();",
                  "    var last = json.data[json.data.length - 1];",
                  "    pm.expect(last.action).to.eql('PRODUCT_CREATED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{notification_host}}/notifications", "host": ["{{notification_host}}"], "path": ["notifications"] }
          }
        }
      ]
    }
  ]
}
